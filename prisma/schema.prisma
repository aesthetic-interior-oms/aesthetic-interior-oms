generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id                     String                      @id @default(cuid())
  name                   String
  phone                  String?                     @unique
  email                  String?
  assignedTo             String?
  created_at             DateTime                    @default(now())
  updated_at             DateTime                    @updatedAt
  budget                 Float?
  location               String?
  remarks                String?
  source                 String?
  stage                  LeadStage                   @default(NEW)
  subStatus              LeadSubStatus?
  primaryOwnerDepartment LeadPrimaryOwnerDepartment?
  primaryOwnerUserId     String?
  quotationType          String?
  agreementType          String?
  agreementValue         Float?
  accountStatus          AccountStatus?
  agreementSqft          Float?
  initialAgreementValue  Float?
  activities             ActivityLog[]
  agreementValueLogs     AgreementValueLog[]
  cadWorkSubmissions     CadWorkSubmission[]
  followUps              FollowUp[]
  assignee               User?                       @relation("UserAssignedLeads", fields: [assignedTo], references: [id])
  primaryOwner           User?                       @relation("LeadPrimaryOwner", fields: [primaryOwnerUserId], references: [id])
  assignments            LeadAssignment[]
  attachments            LeadAttachment[]
  jrArchitectRequests    LeadJrArchitectRequest[]
  meetingEvents          LeadMeetingEvent[]
  phaseTasks             LeadPhaseTask[]
  statusHistory          LeadStatusHistory[]
  notes                  Note[]
  notifications          Notification[]
  quotationDrafts        QuotationDraft[]
  transactions           Transaction[]
  visits                 Visit[]

  @@index([assignedTo])
  @@index([primaryOwnerUserId])
  @@index([email])
  @@index([phone])
}

model LeadAssignment {
  id         String                   @id @default(cuid())
  leadId     String
  userId     String
  department LeadAssignmentDepartment
  createdAt  DateTime                 @default(now())
  lead       Lead                     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leadId, department, userId])
  @@index([leadId])
  @@index([userId])
  @@index([department])
}

model LeadStatusHistory {
  id          String    @id @default(cuid())
  leadId      String
  changedById String
  changedAt   DateTime  @default(now())
  oldStatus   LeadStage
  newStatus   LeadStage
  changedBy   User      @relation(fields: [changedById], references: [id], onDelete: Cascade)
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([changedById])
}

model ActivityLog {
  id          String       @id @default(cuid())
  leadId      String
  userId      String
  type        ActivityType
  description String
  createdAt   DateTime     @default(now())
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId])
}

model FollowUp {
  id            String         @id @default(cuid())
  leadId        String
  assignedToId  String
  followupDate  DateTime
  status        FollowUpStatus @default(PENDING)
  notes         String?
  createdAt     DateTime       @default(now())
  assignedTo    User           @relation(fields: [assignedToId], references: [id], onDelete: Cascade)
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([leadId])
  @@index([assignedToId])
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId])
}

model User {
  id                          String                     @id @default(cuid())
  fullName                    String
  email                       String                     @unique
  phone                       String
  created_at                  DateTime                   @default(now())
  updated_at                  DateTime                   @updatedAt
  clerkUserId                 String?                    @unique
  isActive                    Boolean                    @default(true)
  approvedById                String?
  approvedAt                  DateTime?
  activities                  ActivityLog[]
  agreementValueLogs          AgreementValueLog[]
  cadWorkSubmissions          CadWorkSubmission[]        @relation("CadWorkSubmittedBy")
  deviceTokens                DeviceToken[]
  followUps                   FollowUp[]
  jrArchitectPerformances     JrArchitectPerformance[]
  leads                       Lead[]                     @relation("UserAssignedLeads")
  primaryOwnedLeads           Lead[]                     @relation("LeadPrimaryOwner")
  leadAssignments             LeadAssignment[]
  jrArchitectRequests         LeadJrArchitectRequest[]   @relation("LeadJrArchitectRequestRequestedBy")
  jrArchitectReviewedRequests LeadJrArchitectRequest[]   @relation("LeadJrArchitectRequestReviewedBy")
  meetingEventsCreated        LeadMeetingEvent[]
  phaseReviews                LeadPhaseReview[]
  phaseTasksAssigned          LeadPhaseTask[]            @relation("LeadPhaseTaskAssignee")
  phaseTasksCreated           LeadPhaseTask[]            @relation("LeadPhaseTaskCreator")
  statusChanges               LeadStatusHistory[]
  notes                       Note[]
  signupNotifications         Notification[]             @relation("NotificationSubjectUser")
  notifications               Notification[]
  quotationDraftsCreated      QuotationDraft[]           @relation("QuotationDraftCreatedBy")
  quotationDraftsUpdated      QuotationDraft[]           @relation("QuotationDraftUpdatedBy")
  quotationPerformances       QuotationUserPerformance[]
  transactionsCollected       Transaction[]              @relation("TransactionCollector")
  transactionsRecorded        Transaction[]              @relation("TransactionRecorder")
  approvedBy                  User?                      @relation("UserApprover", fields: [approvedById], references: [id])
  approvedUsers               User[]                     @relation("UserApprover")
  userDepartments             UserDepartment[]
  userRoles                   UserRole[]
  visitsAssigned              Visit[]                    @relation("VisitAssignee")
  visitsCreated               Visit[]                    @relation("VisitCreator")
  supportVisitsAssignedBy     VisitSupportAssignment[]   @relation("VisitSupportAssignedBy")
  supportVisits               VisitSupportAssignment[]   @relation("VisitSupportMember")
  supportVisitResults         VisitSupportResult[]
  visitUpdateRequests         VisitUpdateRequest[]       @relation("VisitUpdateRequestedBy")
  resolvedVisitUpdateRequests VisitUpdateRequest[]       @relation("VisitUpdateResolvedBy")
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgreementValueLog {
  id               String          @id @default(cuid())
  leadId           String
  amount           Float
  note             String?
  createdById      String
  createdAt        DateTime        @default(now())
  quotationDraftId String?
  versionTitle     String?
  createdBy        User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  lead             Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quotationDraft   QuotationDraft? @relation(fields: [quotationDraftId], references: [id])

  @@index([leadId])
  @@index([createdById])
  @@index([quotationDraftId])
}

model LeadPhaseTask {
  id                 String              @id @default(cuid())
  leadId             String
  phaseType          LeadPhaseType
  assigneeUserId     String
  dueAt              DateTime
  status             LeadPhaseTaskStatus @default(OPEN)
  currentReviewRound Int                 @default(0)
  createdById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  workDetails        String?
  startedAt          DateTime            @default(now())
  completedAt        DateTime?
  lastSrActionAt     DateTime?
  sourceVisitId      String?
  reviews            LeadPhaseReview[]
  assignee           User                @relation("LeadPhaseTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: Cascade)
  createdBy          User                @relation("LeadPhaseTaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  lead               Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sourceVisit        Visit?              @relation("LeadPhaseTaskSourceVisit", fields: [sourceVisitId], references: [id])

  @@index([leadId])
  @@index([assigneeUserId])
  @@index([phaseType])
  @@index([status])
  @@index([startedAt])
  @@index([dueAt])
  @@index([sourceVisitId])
}

model LeadJrArchitectRequest {
  id            String                       @id @default(cuid())
  leadId        String
  requestedById String
  status        LeadJrArchitectRequestStatus @default(PENDING)
  note          String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  lead          Lead                         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  requestedBy   User                         @relation("LeadJrArchitectRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy    User?                        @relation("LeadJrArchitectRequestReviewedBy", fields: [reviewedById], references: [id])

  @@index([leadId])
  @@index([requestedById])
  @@index([status])
  @@index([createdAt])
}

model LeadPhaseReview {
  id           String                  @id @default(cuid())
  taskId       String
  roundNo      Int
  submittedAt  DateTime                @default(now())
  reviewedById String
  decision     LeadPhaseReviewDecision
  comment      String?
  reviewedBy   User                    @relation(fields: [reviewedById], references: [id], onDelete: Cascade)
  task         LeadPhaseTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, roundNo])
  @@index([taskId])
  @@index([reviewedById])
}

model LeadMeetingEvent {
  id          String               @id @default(cuid())
  leadId      String
  type        LeadMeetingEventType
  title       String
  notes       String?
  startsAt    DateTime
  endsAt      DateTime?
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  lead        Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([type])
  @@index([startsAt])
  @@index([createdById])
}

model CadWorkSubmission {
  id            String                  @id @default(cuid())
  leadId        String
  submittedById String
  note          String?
  submittedAt   DateTime                @default(now())
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  lead          Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  submittedBy   User                    @relation("CadWorkSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  files         CadWorkSubmissionFile[]

  @@index([leadId])
  @@index([submittedById])
  @@index([submittedAt])
}

model QuotationDraft {
  id                 String               @id @default(cuid())
  leadId             String
  createdById        String
  updatedById        String?
  quotationType      String               @default("STANDARD")
  projectSqft        Float?
  content            Json
  grandTotal         Float                @default(0)
  status             QuotationDraftStatus @default(DRAFT)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  draftKey           String               @default("detail")
  agreementValueLogs AgreementValueLog[]
  createdBy          User                 @relation("QuotationDraftCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  lead               Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  updatedBy          User?                @relation("QuotationDraftUpdatedBy", fields: [updatedById], references: [id])

  @@unique([leadId, draftKey])
  @@index([createdById])
  @@index([status])
}

model CadWorkSubmissionFile {
  id           String                @id @default(cuid())
  submissionId String
  url          String
  fileName     String
  fileType     String
  cadFileType  CadSubmissionFileType
  sizeBytes    Int?
  createdAt    DateTime              @default(now())
  submission   CadWorkSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([cadFileType])
}

model Visit {
  id                 String                   @id @default(cuid())
  leadId             String
  assignedToId       String?
  scheduledAt        DateTime
  status             VisitStatus              @default(SCHEDULED)
  location           String
  notes              String?
  createdById        String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  projectSqft        Float?
  projectStatus      ProjectStatus?
  visitFee           Float                    @default(0)
  cadPhaseTasks      LeadPhaseTask[]          @relation("LeadPhaseTaskSourceVisit")
  notifications      Notification[]
  visitPayments      Transaction[]            @relation("VisitPayments")
  assignedTo         User?                    @relation("VisitAssignee", fields: [assignedToId], references: [id])
  createdBy          User                     @relation("VisitCreator", fields: [createdById], references: [id], onDelete: Cascade)
  lead               Lead                     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  result             VisitResult?
  supportAssignments VisitSupportAssignment[]
  supportResults     VisitSupportResult[]
  updateRequests     VisitUpdateRequest[]

  @@index([leadId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([scheduledAt])
}

model VisitUpdateRequest {
  id                  String                   @id @default(cuid())
  visitId             String
  type                VisitUpdateRequestType
  status              VisitUpdateRequestStatus @default(PENDING)
  reason              String
  requestedScheduleAt DateTime?
  requestedById       String
  resolvedById        String?
  createdAt           DateTime                 @default(now())
  resolvedAt          DateTime?
  requestedBy         User                     @relation("VisitUpdateRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  resolvedBy          User?                    @relation("VisitUpdateResolvedBy", fields: [resolvedById], references: [id])
  visit               Visit                    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([status])
  @@index([requestedById])
  @@index([resolvedById])
}

model VisitResult {
  id                 String       @id @default(cuid())
  visitId            String       @unique
  summary            String
  measurements       Json?
  clientMood         String?
  completedAt        DateTime     @default(now())
  clientPotentiality String?
  projectType        String?
  clientPersonality  String?
  budgetRange        String?
  timelineUrgency    String?
  stylePreference    String?
  files              Attachment[]
  visit              Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model VisitSupportAssignment {
  id            String              @id @default(cuid())
  visitId       String
  supportUserId String
  assignedById  String
  createdAt     DateTime            @default(now())
  assignedBy    User                @relation("VisitSupportAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  supportUser   User                @relation("VisitSupportMember", fields: [supportUserId], references: [id], onDelete: Cascade)
  visit         Visit               @relation(fields: [visitId], references: [id], onDelete: Cascade)
  result        VisitSupportResult?

  @@unique([visitId, supportUserId])
  @@index([visitId])
  @@index([supportUserId])
}

model VisitSupportResult {
  id                  String                 @id @default(cuid())
  visitId             String
  supportAssignmentId String                 @unique
  supportUserId       String
  clientName          String
  projectArea         String
  projectStatus       String
  extraConcern        String?
  completedAt         DateTime               @default(now())
  files               SupportAttachment[]
  supportAssignment   VisitSupportAssignment @relation(fields: [supportAssignmentId], references: [id], onDelete: Cascade)
  supportUser         User                   @relation(fields: [supportUserId], references: [id], onDelete: Cascade)
  visit               Visit                  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, supportUserId])
  @@index([visitId])
  @@index([supportUserId])
}

model Attachment {
  id            String      @id @default(cuid())
  url           String
  fileName      String
  fileType      String
  visitResultId String
  createdAt     DateTime    @default(now())
  visitResult   VisitResult @relation(fields: [visitResultId], references: [id], onDelete: Cascade)

  @@index([visitResultId])
}

model LeadAttachment {
  id        String   @id @default(cuid())
  leadId    String
  url       String
  fileName  String
  fileType  String
  category  String
  sizeBytes Int?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([category])
}

model SupportAttachment {
  id              String             @id @default(cuid())
  supportResultId String
  url             String
  fileName        String
  fileType        String
  createdAt       DateTime           @default(now())
  supportResult   VisitSupportResult @relation(fields: [supportResultId], references: [id], onDelete: Cascade)

  @@index([supportResultId])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  leadId        String?
  followUpId    String?
  type          NotificationType
  title         String
  message       String
  scheduledFor  DateTime?
  isRead        Boolean          @default(false)
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  visitId       String?
  subjectUserId String?
  followUp      FollowUp?        @relation(fields: [followUpId], references: [id])
  lead          Lead?            @relation(fields: [leadId], references: [id])
  subjectUser   User?            @relation("NotificationSubjectUser", fields: [subjectUserId], references: [id])
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  visit         Visit?           @relation(fields: [visitId], references: [id])

  @@unique([userId, followUpId, type])
  @@unique([userId, visitId, type])
  @@unique([userId, subjectUserId, type])
  @@index([userId])
  @@index([leadId])
  @@index([followUpId])
  @@index([visitId])
  @@index([subjectUserId])
  @@index([isRead])
  @@index([createdAt])
}

model FacebookSyncControl {
  id                      String    @id @default("default")
  enabled                 Boolean   @default(true)
  fallbackEnabled         Boolean   @default(true)
  fallbackIntervalMinutes Int       @default(15)
  batchLimit              Int       @default(20)
  lastSyncAt              DateTime?
  lastSyncStatus          String?
  lastSyncFetched         Int?
  lastSyncCreated         Int?
  lastSyncError           String?
  lastSyncTrigger         String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  incrementalCursor       String?
  incrementalWatermark    DateTime?
  jrCrmRoundRobinOffset   Int       @default(0)
  latestEnabled           Boolean   @default(true)
  latestIntervalMinutes   Int       @default(2)
  latestBatchLimit        Int       @default(20)
  backfillEnabled         Boolean   @default(true)
  backfillIntervalMinutes Int       @default(15)
  backfillBatchLimit      Int       @default(20)
  lastLatestSyncAt        DateTime?
  lastLatestSyncStatus    String?
  lastLatestSyncFetched   Int?
  lastLatestSyncCreated   Int?
  lastLatestSyncError     String?
  lastBackfillSyncAt      DateTime?
  lastBackfillSyncStatus  String?
  lastBackfillSyncFetched Int?
  lastBackfillSyncCreated Int?
  lastBackfillSyncError   String?
  latestWatermark         DateTime?
  backfillCursor          String?
}

model InstagramSyncControl {
  id                      String    @id @default("default")
  enabled                 Boolean   @default(true)
  fallbackEnabled         Boolean   @default(true)
  fallbackIntervalMinutes Int       @default(15)
  batchLimit              Int       @default(20)
  lastSyncAt              DateTime?
  lastSyncStatus          String?
  lastSyncFetched         Int?
  lastSyncCreated         Int?
  lastSyncError           String?
  lastSyncTrigger         String?
  incrementalCursor       String?
  incrementalWatermark    DateTime?
  jrCrmRoundRobinOffset   Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model WhatsAppWebhookControl {
  id                           String    @id @default("default")
  enabled                      Boolean   @default(true)
  lastWebhookAt                DateTime?
  lastWebhookStatus            String?
  lastWebhookError             String?
  lastProcessedMessages        Int       @default(0)
  lastCreatedLeads             Int       @default(0)
  lastSkippedExistingPhone     Int       @default(0)
  lastSkippedNoPhone           Int       @default(0)
  lastSkippedDuplicateMessage  Int       @default(0)
  totalWebhookEvents           Int       @default(0)
  totalProcessedMessages       Int       @default(0)
  totalCreatedLeads            Int       @default(0)
  totalSkippedExistingPhone    Int       @default(0)
  totalSkippedNoPhone          Int       @default(0)
  totalSkippedDuplicateMessage Int       @default(0)
  jrCrmRoundRobinOffset        Int       @default(0)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
}

model WhatsAppProcessedMessage {
  id        String   @id @default(cuid())
  messageId String   @unique
  phone     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model VisitWorkflowControl {
  id                               String    @id @default("default")
  supportDataEnabled               Boolean   @default(true)
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt
  weeklySeniorCrmUserId            String?
  weeklySeniorCrmWeekStart         DateTime?
  weeklySeniorCrmAutomationEnabled Boolean   @default(true)
}

model WhatsAppWebhookEvent {
  id                      String   @id @default(cuid())
  status                  String
  source                  String?
  processedMessages       Int      @default(0)
  createdLeads            Int      @default(0)
  skippedExistingPhone    Int      @default(0)
  skippedNoPhone          Int      @default(0)
  skippedDuplicateMessage Int      @default(0)
  error                   String?
  createdAt               DateTime @default(now())

  @@index([createdAt])
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  userRoles   UserRole[]
}

model Department {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  userDepartments UserDepartment[]
}

model UserRole {
  userId     String
  roleId     String
  created_at DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model UserDepartment {
  userId       String
  departmentId String
  created_at   DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
}

model FinanceAccount {
  id           String        @id @default(cuid())
  name         String        @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id               String          @id @default(cuid())
  date             DateTime        @default(now())
  type             TransactionType
  particular       String
  amount           Float
  recordedById     String
  leadId           String?
  category         String
  serialNo         Int             @default(autoincrement())
  voucherNo        String?         @unique
  visitId          String?
  collectedById    String?
  financeAccountId String?
  imageUrl         String?
  collectedBy      User?           @relation("TransactionCollector", fields: [collectedById], references: [id])
  financeAccount   FinanceAccount? @relation(fields: [financeAccountId], references: [id])
  lead             Lead?           @relation(fields: [leadId], references: [id])
  recordedBy       User            @relation("TransactionRecorder", fields: [recordedById], references: [id])
  visit            Visit?          @relation("VisitPayments", fields: [visitId], references: [id])

  @@index([leadId])
  @@index([visitId])
  @@index([recordedById])
  @@index([collectedById])
  @@index([date])
}

model CashFlowDaily {
  id          String   @id @default(cuid())
  date        DateTime @unique @default(now())
  openingCash Float    @default(0)
  openingBank Float    @default(0)
  closingCash Float    @default(0)
  closingBank Float    @default(0)
  isClosed    Boolean  @default(false)
}

model WebsiteProject {
  id           String                @id @default(cuid())
  slug         String                @unique
  title        String
  ownerName    String?
  type         String?
  sqft         String?
  duration     String?
  category     String                @default("residential")
  location     String?
  thumbnailUrl String
  description  String
  details      String?
  isPublished  Boolean               @default(true)
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  images       WebsiteProjectImage[]

  @@index([isPublished, sortOrder])
  @@index([category])
}

model WebsiteProjectImage {
  id        String         @id @default(cuid())
  projectId String
  url       String
  alt       String?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  project   WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model WebsiteVideo {
  id           String   @id @default(cuid())
  title        String
  url          String
  provider     String   @default("youtube")
  videoId      String?
  embedUrl     String
  thumbnailUrl String?
  duration     String?
  isFeatured   Boolean  @default(false)
  isPublished  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([isPublished, isFeatured, sortOrder])
}

model WebsiteTestimonial {
  id          String   @id @default(cuid())
  quote       String
  author      String
  project     String
  image       String
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([isPublished, sortOrder])
}

model WebsiteTeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  image       String
  specialty   String?
  quote       String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([isPublished, sortOrder])
}

model QuotationTemplateOverride {
  id           String   @id @default(cuid())
  templateKey  String
  itemId       String
  sectionId    String?
  description  String?
  materials    String?
  unit         String?
  priceMode    String?
  basicRate    Float?
  standardRate Float?
  premiumRate  Float?
  rateMin      Float?
  rateMax      Float?
  isNewItem    Boolean  @default(false)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([templateKey, itemId])
  @@index([templateKey])
}

model JrArchitectPerformance {
  id               String   @id @default(cuid())
  userId           String
  monthYear        String
  totalWork        Int      @default(0)
  totalSqft        Float    @default(0)
  totalTimeMinutes Int      @default(0)
  performanceScore Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthYear])
  @@index([userId])
  @@index([monthYear])
}

model QuotationUserPerformance {
  id               String   @id @default(cuid())
  userId           String
  monthKey         String
  detailSqft       Float    @default(0)
  shortSqft        Float    @default(0)
  totalSqft        Float    @default(0)
  completedCount   Int      @default(0)
  avgWorkingHours  Float    @default(0)
  performanceScore Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthKey])
  @@index([userId])
  @@index([monthKey])
}

